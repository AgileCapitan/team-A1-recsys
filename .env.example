# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Streamlit API target
API_URL=http://backend:8000

# Optional URL prefixes for the Oracle HTTPS reverse proxy. Keep these blank
# for direct local access; on Oracle set API_ROOT_PATH=/api and
# MLFLOW_STATIC_PREFIX=/mlflow.
API_ROOT_PATH=
MLFLOW_HOST=team-a1-recsys.duckdns.org
MLFLOW_STATIC_PREFIX=
MLFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,mlflow,team-a1-recsys.duckdns.org
MLFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://team-a1-recsys.duckdns.org
MLFLOW_AUTH_USER=mlflow
MLFLOW_AUTH_PASSWORD_HASH=

# B2 is used for shared object storage. Never commit real credentials.
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
