# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Streamlit API target
API_URL=http://backend:8000

# Model & catalog artifacts mounted into backend container
ARTIFACTS_DIR=./artifacts
MODEL_ARTIFACT_PATH=/app/artifacts/movielens-v1.joblib
CATALOG_PATH=/app/artifacts/movie-catalog.csv
POSTERS_DIR=/app/artifacts/posters
ALLOW_FALLBACK_PREDICTOR=true

# B2 is used for shared object storage. Never commit real credentials.
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
