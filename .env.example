# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Streamlit API target
API_URL=http://backend:8000

# RustFS development credentials; use unique values outside local development.
RUSTFS_ACCESS_KEY=recsys-local-access
RUSTFS_SECRET_KEY=recsys-local-secret-change-me
RUSTFS_BUCKET=recsys
RUSTFS_REGION=us-east-1
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
